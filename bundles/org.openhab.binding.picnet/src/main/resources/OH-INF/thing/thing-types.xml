				<label>Bit 15</label>
			</channel>
			<channel id="bit16" typeId="contact-bit-static">
				<label>Bit 16</label>
			</channel>
		</channels>

		<config-description>
			<parameter name="address" type="integer" required="true" min="1" max="250">
