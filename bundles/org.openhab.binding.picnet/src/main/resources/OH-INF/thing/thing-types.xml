<?xml version="1.0" encoding="UTF-8"?>
<thing:thing-descriptions bindingId="picnet"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:thing="https://openhab.org/schemas/thing-description/v1.0.0"
	xsi:schemaLocation="https://openhab.org/schemas/thing-description/v1.0.0 https://openhab.org/schemas/thing-description-1.0.0.xsd">

	<!-- PicNet Bridge -->
	<bridge-type id="bridge">
		<label>PicNet Bridge</label>
		<description>Bridge to connect to PicNet system via Sapp protocol</description>

		<config-description>
			<parameter name="hostname" type="text" required="true">
				<context>network-address</context>
				<label>Hostname</label>
				<description>Hostname or IP address of the PicNet device</description>
			</parameter>
			<parameter name="port" type="integer" required="true">
				<label>Port</label>
				<description>TCP port of the PicNet device</description>
				<default>7001</default>
			</parameter>
			<parameter name="refreshInterval" type="integer" unit="ms" min="100" max="60000">
				<label>Refresh Interval</label>
				<description>Interval the device is polled in milliseconds</description>
				<default>1000</default>
				<advanced>true</advanced>
			</parameter>
		</config-description>
	</bridge-type>

	<!-- Virtual Thing Type -->
	<thing-type id="virtual">
		<supported-bridge-type-refs>
			<bridge-type-ref id="bridge"/>
		</supported-bridge-type-refs>

		<label>PicNet Virtual</label>
		<description>Virtual address in PicNet system (read/write)</description>

		<channels>
			<!-- Word and Signed -->
			<channel id="word" typeId="number-word">
				<label>Word Value</label>
				<description>Full 16-bit word value (0-65535)</description>
			</channel>
			<channel id="signedWord" typeId="number-signed">
				<label>Signed Word</label>
				<description>Signed 16-bit value (-32768 to 32767)</description>
			</channel>

			<!-- Bytes -->
			<channel id="highByte" typeId="number-byte-static">
				<label>High Byte</label>
				<description>High byte (0-255)</description>
			</channel>
			<channel id="lowByte" typeId="number-byte-static">
				<label>Low Byte</label>
				<description>Low byte (0-255)</description>
			</channel>
			<channel id="highByteSigned" typeId="number-byte-static">
				<label>High Byte Signed</label>
				<description>High byte signed (-128 to 127)</description>
			</channel>
			<channel id="lowByteSigned" typeId="number-byte-static">
				<label>Low Byte Signed</label>
				<description>Low byte signed (-128 to 127)</description>
			</channel>

			<!-- Bits as Switches (for Virtual write) -->
			<channel id="bit1" typeId="switch-bit-static">
				<label>Bit 1</label>
			</channel>
			<channel id="bit2" typeId="switch-bit-static">
				<label>Bit 2</label>
			</channel>
			<channel id="bit3" typeId="switch-bit-static">
				<label>Bit 3</label>
			</channel>
			<channel id="bit4" typeId="switch-bit-static">
				<label>Bit 4</label>
			</channel>
			<channel id="bit5" typeId="switch-bit-static">
				<label>Bit 5</label>
			</channel>
			<channel id="bit6" typeId="switch-bit-static">
				<label>Bit 6</label>
			</channel>
			<channel id="bit7" typeId="switch-bit-static">
				<label>Bit 7</label>
			</channel>
			<channel id="bit8" typeId="switch-bit-static">
				<label>Bit 8</label>
			</channel>
			<channel id="bit9" typeId="switch-bit-static">
				<label>Bit 9</label>
			</channel>
			<channel id="bit10" typeId="switch-bit-static">
				<label>Bit 10</label>
			</channel>
			<channel id="bit11" typeId="switch-bit-static">
				<label>Bit 11</label>
			</channel>
			<channel id="bit12" typeId="switch-bit-static">
				<label>Bit 12</label>
			</channel>
			<channel id="bit13" typeId="switch-bit-static">
				<label>Bit 13</label>
			</channel>
			<channel id="bit14" typeId="switch-bit-static">
				<label>Bit 14</label>
			</channel>
			<channel id="bit15" typeId="switch-bit-static">
				<label>Bit 15</label>
			</channel>
			<channel id="bit16" typeId="switch-bit-static">
				<label>Bit 16</label>
			</channel>
		</channels>

		<config-description>
			<parameter name="address" type="integer" required="true" min="1" max="2500">
				<label>Virtual Address</label>
				<description>Virtual address number (1-2500)</description>
			</parameter>
		</config-description>
	</thing-type>

