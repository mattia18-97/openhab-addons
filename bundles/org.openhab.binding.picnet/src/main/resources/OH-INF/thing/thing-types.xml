			<channel id="bit6" typeId="contact-bit-static">
				<label>Bit 6</label>
			</channel>
			<channel id="bit7" typeId="contact-bit-static">
				<label>Bit 7</label>
			</channel>
			<channel id="bit8" typeId="contact-bit-static">
