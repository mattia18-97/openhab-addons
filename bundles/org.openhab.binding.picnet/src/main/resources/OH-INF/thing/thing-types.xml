	<!-- Light Thing Type (single light control) -->
	<thing-type id="light">
		<supported-bridge-type-refs>
			<bridge-type-ref id="bridge"/>
		</supported-bridge-type-refs>

		<label>PicNet Light</label>
		<description>A single light (reads status from Input/Output/Virtual, writes commands to Virtual address)</description>

		<channels>
			<channel id="switch" typeId="system.power">
				<label>Light Switch</label>
				<description>Turn the light on or off</description>
			</channel>
		</channels>

		<config-description>
			<parameter name="readType" type="text" required="true">
				<label>Read Type</label>
				<description>Type of address to read light status from</description>
				<options>
					<option value="input">Input Module</option>
					<option value="output">Output Module</option>
					<option value="virtual">Virtual Address</option>
				</options>
				<default>output</default>
			</parameter>
			<parameter name="readAddress" type="integer" required="true" min="1" max="2500">
				<label>Read Address</label>
				<description>Address to read the light status from (1-250 for Input/Output, 1-2500 for Virtual)</description>
			</parameter>
			<parameter name="readBit" type="integer" required="true" min="1" max="16">
				<label>Read Bit Number</label>
				<description>Bit number to read light status from (1-16)</description>
				<default>1</default>
			</parameter>
			<parameter name="virtualAddress" type="integer" required="true" min="1" max="2500">
				<label>Virtual Address</label>
				<description>Virtual address to write light commands to (1-2500)</description>
			</parameter>
			<parameter name="writeBit" type="integer" required="true" min="1" max="16">
				<label>Write Bit Number</label>
				<description>Bit number to write light commands to (1-16)</description>
				<default>1</default>
			</parameter>
			<parameter name="pulseMode" type="boolean" required="false">
				<label>Pulse Mode</label>
				<description>Send a pulse (1) for both ON and OFF commands, like a momentary push button</description>
				<default>false</default>
			</parameter>
		</config-description>
	</thing-type>

	<!-- Gate Thing Type (gate control with optional status) -->
	<thing-type id="gate">
		<supported-bridge-type-refs>
			<bridge-type-ref id="bridge"/>
		</supported-bridge-type-refs>

		<label>PicNet Gate</label>
		<description>Gate control (optionally reads status from Input/Output/Virtual, writes trigger commands to Virtual
			address)</description>

		<channels>
			<channel id="switch" typeId="system.power">
				<label>Gate Switch</label>
				<description>Trigger the gate (typically momentary/pulse mode)</description>
			</channel>
		</channels>

		<config-description>
			<parameter name="readType" type="text" required="false">
				<label>Read Type (Optional)</label>
				<description>Type of address to read gate status from (leave empty for command-only mode)</description>
				<options>
					<option value="">None (Command Only)</option>
					<option value="input">Input Module</option>
					<option value="output">Output Module</option>
					<option value="virtual">Virtual Address</option>
				</options>
				<default></default>
			</parameter>
			<parameter name="readAddress" type="integer" required="false" min="0" max="2500">
				<label>Read Address (Optional)</label>
				<description>Address to read the gate status from (1-250 for Input/Output, 1-2500 for Virtual, 0 if not used)</description>
				<default>0</default>
			</parameter>
			<parameter name="readBit" type="integer" required="false" min="1" max="16">
				<label>Read Bit Number (Optional)</label>
				<description>Bit number to read gate status from (1-16)</description>
				<default>1</default>
			</parameter>
			<parameter name="virtualAddress" type="integer" required="true" min="1" max="2500">
				<label>Virtual Address</label>
				<description>Virtual address to write gate trigger commands to (1-2500)</description>
			</parameter>
			<parameter name="writeBit" type="integer" required="true" min="1" max="16">
				<label>Write Bit Number</label>
				<description>Bit number to write gate commands to (1-16)</description>
				<default>1</default>
			</parameter>
			<parameter name="pulseMode" type="boolean" required="false">
				<label>Pulse Mode</label>
				<description>Send a momentary pulse (typical for gates)</description>
				<default>true</default>
			</parameter>
		</config-description>
	</thing-type>

	<!-- Alarm Thing Type -->
	<thing-type id="alarm">
		<supported-bridge-type-refs>
			<bridge-type-ref id="bridge"/>
		</supported-bridge-type-refs>

		<label>PicNet Alarm</label>
		<description>Alarm sensor in PicNet system (read-only, batch-optimized with Sapp72Command)</description>

		<channels>
			<channel id="alarm" typeId="system.alarm">
				<label>Alarm Status</label>
				<description>Alarm status (CLOSED=OK, OPEN=TRIGGERED)</description>
			</channel>
		</channels>

		<config-description>
			<parameter name="alarmNumber" type="integer" required="true" min="1" max="255">
				<label>Alarm Number</label>
				<description>Alarm number to monitor (1-255)</description>
				<default>1</default>
			</parameter>
		</config-description>
	</thing-type>

	<!-- Alarm Group Thing Type -->
	<thing-type id="alarm-group">
		<supported-bridge-type-refs>
			<bridge-type-ref id="bridge"/>
		</supported-bridge-type-refs>

		<label>PicNet Alarm Group</label>
		<description>Master alarm monitoring a range of alarms (batch-optimized with Sapp72Command)</description>

		<channels>
			<channel id="master-alarm" typeId="system.alarm">
				<label>Master Alarm Status</label>
				<description>Master alarm status (CLOSED=all OK, OPEN=at least one alarm triggered)</description>
			</channel>
		</channels>

		<config-description>
			<parameter name="startAlarm" type="integer" required="true" min="1" max="255">
				<label>Start Alarm Number</label>
				<description>First alarm number to monitor (1-255)</description>
				<default>1</default>
			</parameter>
			<parameter name="endAlarm" type="integer" required="true" min="1" max="255">
				<label>End Alarm Number</label>
				<description>Last alarm number to monitor (1-255)</description>
				<default>255</default>
			</parameter>
		</config-description>
	</thing-type>

	<!-- Channel Types -->

	<!-- Number Word Channel -->
	<channel-type id="number-word">
		<item-type>Number</item-type>
		<label>Word Value</label>
		<description>16-bit word value (0-65535)</description>
		<state readOnly="false" min="0" max="65535" pattern="%d"/>
	</channel-type>

	<!-- Switch Linked Channel -->
	<channel-type id="switch-linked">
		<item-type>Switch</item-type>
		<label>Switch</label>
		<description>Switch control linked to read address and write virtual</description>

		<config-description>
			<parameter name="readFrom" type="text" required="true">
				<label>Read From</label>
				<description>Read address in format TYPE:ADDRESS:SUBADDRESS (e.g., O:60:1 or V:200:*)</description>
			</parameter>
			<parameter name="writeBit" type="integer" required="true" min="1" max="16">
				<label>Write Bit</label>
				<description>Bit position to write on the Virtual address (1-16)</description>
			</parameter>
			<parameter name="onValue" type="integer">
				<label>ON Value</label>
				<description>Value to send for ON command</description>
				<default>1</default>
			</parameter>
			<parameter name="offValue" type="integer">
				<label>OFF Value</label>
				<description>Value to send for OFF command</description>
				<default>1</default>
			</parameter>
		</config-description>
	</channel-type>

	<!-- Contact Channel -->
	<channel-type id="contact-bit">
		<item-type>Contact</item-type>
		<label>Contact</label>
		<description>Contact sensor (bit value)</description>

		<config-description>
			<parameter name="bit" type="integer" required="true" min="1" max="16">
				<label>Bit Position</label>
				<description>Bit position to read (1-16)</description>
			</parameter>
			<parameter name="inverted" type="boolean">
				<label>Inverted</label>
				<description>Invert the contact state (NC contact)</description>
				<default>true</default>
			</parameter>
		</config-description>
	</channel-type>

	<!-- Switch Bit Channel -->
	<channel-type id="switch-bit">
		<item-type>Switch</item-type>
		<label>Switch Bit</label>
		<description>Switch control for a single bit (only for Virtual addresses)</description>

		<config-description>
			<parameter name="bit" type="integer" required="true" min="1" max="16">
				<label>Bit Position</label>
				<description>Bit position to control (1-16)</description>
			</parameter>
			<parameter name="onValue" type="integer">
				<label>ON Value</label>
				<description>Value to send for ON command (0 or 1)</description>
				<default>1</default>
			</parameter>
			<parameter name="offValue" type="integer">
				<label>OFF Value</label>
				<description>Value to send for OFF command (0 or 1)</description>
				<default>1</default>
			</parameter>
		</config-description>
	</channel-type>

	<!-- Number Byte Channel -->
	<channel-type id="number-byte">
		<item-type>Number</item-type>
		<label>Byte Value</label>
		<description>8-bit byte value (0-255 or -128 to 127 if signed)</description>

		<config-description>
			<parameter name="subAddress" type="text" required="true">
				<label>Sub Address</label>
				<description>Byte to read: H (high byte), L (low byte), H+ (signed high), L+ (signed low)</description>
				<options>
					<option value="H">High Byte (0-255)</option>
					<option value="L">Low Byte (0-255)</option>
					<option value="H+">High Byte Signed (-128 to 127)</option>
					<option value="L+">Low Byte Signed (-128 to 127)</option>
				</options>
			</parameter>
		</config-description>
	</channel-type>

	<!-- Number Signed Channel -->
	<channel-type id="number-signed">
		<item-type>Number</item-type>
		<label>Signed Word Value</label>
		<description>16-bit signed word value (-32768 to 32767)</description>
		<state readOnly="false" min="-32768" max="32767" pattern="%d"/>
	</channel-type>

	<!-- Static Channel Types (no configuration needed) -->

	<!-- Static Switch Bit (for Virtual) -->
	<channel-type id="switch-bit-static">
		<item-type>Switch</item-type>
		<label>Bit Switch</label>
		<description>Switch for a single bit</description>
	</channel-type>

	<!-- Static Contact Bit (for Input/Output) -->
	<channel-type id="contact-bit-static">
		<item-type>Contact</item-type>
		<label>Bit Contact</label>
		<description>Contact for a single bit (inverted by default)</description>
	</channel-type>

	<!-- Static Number Byte -->
	<channel-type id="number-byte-static">
		<item-type>Number</item-type>
		<label>Byte Value</label>
		<description>8-bit value</description>
		<state pattern="%d"/>
	</channel-type>

</thing:thing-descriptions>
