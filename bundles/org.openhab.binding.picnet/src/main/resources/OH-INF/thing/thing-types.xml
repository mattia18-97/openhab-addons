			<channel id="highByteSigned" typeId="number-byte-static">
				<label>High Byte Signed</label>
				<description>High byte signed (-128 to 127)</description>
			</channel>
			<channel id="lowByteSigned" typeId="number-byte-static">
				<label>Low Byte Signed</label>
				<description>Low byte signed (-128 to 127)</description>
			</channel>

			<!-- Bits as Contacts (read-only) -->
			<channel id="bit1" typeId="contact-bit-static">
